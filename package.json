{
  "name": "dsh-chatgpt-login",
  "version": "0.2.0",
  "type": "module",
  "description": "ChatGPT OAuth login for DeepSeek Harness (DSH), including Web and Desktop",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulagala001/dsh-chatgpt-login.git"
  },
  "homepage": "https://github.com/gulagala001/dsh-chatgpt-login#readme",
  "bugs": {
    "url": "https://github.com/gulagala001/dsh-chatgpt-login/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "chatgpt",
    "oauth",
    "codex",
    "dsh-plugin"
  ]
}
